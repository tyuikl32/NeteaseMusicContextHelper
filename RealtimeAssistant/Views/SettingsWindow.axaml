<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RealtimeAssistant.ViewModels"
        xmlns:models="using:RealtimeAssistant.Models"
        xmlns:loc="using:RealtimeAssistant.Localization"
        x:Class="RealtimeAssistant.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{loc:Loc Settings}"
        Width="520"
        Height="620"
        MinWidth="420"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="10">
            <TextBlock Text="{loc:Loc Language}" FontSize="16" FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="loc:LanguageOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{loc:Loc LlmProvider}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatProviderConfig">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="{loc:Loc Add}" Command="{Binding AddProviderCommand}" />
                <Button Grid.Column="2" Content="{loc:Loc Remove}" Command="{Binding RemoveProviderCommand}" />
            </Grid>

            <TextBlock Text="{loc:Loc ProviderName}" />
            <TextBox Text="{Binding ProviderName, Mode=TwoWay}" />
            <TextBlock Text="{loc:Loc Endpoint}" />
            <TextBox Text="{Binding Endpoint, Mode=TwoWay}" />
            <TextBlock Text="{loc:Loc Model}" />
            <TextBox Text="{Binding Model, Mode=TwoWay}" />
            <TextBlock Text="{loc:Loc ApiKey}" />
            <TextBox Text="{Binding ApiKey, Mode=TwoWay}" />

            <CheckBox IsChecked="{Binding BuiltInSearchEnabled, Mode=TwoWay}">
                <TextBlock Text="{loc:Loc BuiltInSearch}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{loc:Loc BuiltInSearchHint}"
                       TextWrapping="Wrap" Opacity="0.7" />

            <TextBlock Text="{loc:Loc WebSearch}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" />
            <CheckBox IsChecked="{Binding WebSearchEnabled, Mode=TwoWay}">
                <TextBlock Text="{loc:Loc LocalSearch}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{loc:Loc LocalSearchHint}"
                       TextWrapping="Wrap" Opacity="0.7" />
            <TextBlock Text="{loc:Loc TavilyApiKey}" />
            <TextBox Text="{Binding WebSearchApiKey, Mode=TwoWay}"
                     PasswordChar="●"
                     IsEnabled="{Binding WebSearchEnabled}" />

            <TextBlock Text="{loc:Loc UserPrompt}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" />
            <TextBox Text="{Binding UserPrompt, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="150"
                     VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <CheckBox Content="{loc:Loc ColdMode}" IsChecked="{Binding ColdMode, Mode=TwoWay}" />
            <TextBlock Text="{Binding ErrorText}" Foreground="Firebrick" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" MinWidth="72" />
                <Button Content="{loc:Loc Save}" Command="{Binding SaveCommand}" MinWidth="72" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
